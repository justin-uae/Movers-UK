# Dependencies
node_modules

# Next.js build output
.next
.turbo
out
build
dist
next-env.d.ts

# Environment secrets — never commit real keys (.env.local.example is fine, stays tracked)
.env
.env.*
.env.local
.env*.local
!.env.local.example

# Private keys / credential files (e.g. a Vonage private.key)
*.key
*.p8
*.p12
*.pfx

