supabase/.temp
supabase/.branches
supabase/.env

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log

# TypeScript
*.tsbuildinfo

# Test coverage
coverage

